# browser-agent 环境变量示例
# 用法：复制本文件为 .env 并填入你的值，再运行 ./start.sh（会自动加载 .env）；
# 或者直接 export 这些变量后运行 node server.js。

# BA_TOKEN — API 鉴权令牌（可选，强烈建议设置）
# 设置后，除 GET /status 外，所有接口都必须带请求头：
#   Authorization: Bearer <你的令牌>
# 不设置则无鉴权，仅适合完全可信的本机环境。
BA_TOKEN=

# QWEN_API_KEY — 通义千问 API Key（可选）
# 仅 /ocr 接口（图片/验证码文字识别，模型 qwen-vl-max）需要；
# 不用 /ocr 可以留空，不影响其他功能。
QWEN_API_KEY=

# PORT — 服务端口（当前版本固定为 9223，暂不支持用环境变量修改；
# 如需改端口，请修改 server.js 顶部的 const PORT 一行）
# PORT=9223
